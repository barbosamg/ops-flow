@page "/orders"
@using System.Text.Json
@using OpsFlow.Web.Clients.Orders
@using OpsFlow.Web.Components.Orders
@using OpsFlow.Web.Models.Orders
@using OpsFlow.Web.Clients.Providers
@using OpsFlow.Web.Models.Providers
@inject IProvidersApiClient ProvidersApiClient
@implements IDisposable
@inject IOrdersApiClient OrdersApiClient

<PageTitle>Orders | OpsFlow</PageTitle>

<section class="ops-page">
    <header class="ops-page-header">
        <span class="ops-eyebrow">Orders workspace</span>
        <h1>Orders</h1>
        <p>
            Search, filter and act on orders without losing operational context.
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="ops-orders-error" role="alert">
            @LoadError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ProviderLoadError))
    {
        <div class="ops-orders-error" role="alert">
            @ProviderLoadError
        </div>
    }

    <div class="ops-placeholder ops-grid-surface">
        <TelerikGrid TItem="@OrderListItem" OnRead="@ReadOrdersAsync" @ref="_ordersGrid" Pageable="true" Sortable="true"
                     Resizable="true" PageSize="5">
            <GridToolBar>
                <GridToolBarCustomTool>
                    <label class="ops-status-filter">
                        <span>Status</span>

                        <TelerikDropDownList Data="@StatusOptions" TItem="@string" TValue="@string"
                                             Value="@SelectedStatus" ValueChanged="@((string value) => OnStatusChangedAsync(value))"
                                             AriaLabel="Filter orders by status" Width="180px" />
                    </label>
                </GridToolBarCustomTool>

                <GridToolBarCustomTool>
                    <label class="ops-status-filter">
                        <span>Provider</span>

                        <TelerikDropDownList Data="@ProviderOptions" TItem="@ProviderOption" TValue="@Guid"
                                             TextField="@nameof(ProviderOption.Name)" ValueField="@nameof(ProviderOption.Id)"
                                             Value="@SelectedProviderId" ValueChanged="@((Guid value) => OnProviderChangedAsync(value))"
                                             AriaLabel="Filter orders by provider" Width="200px" />
                    </label>
                </GridToolBarCustomTool>

                <GridToolBarSpacerTool />
                <GridToolBarSearchBoxTool Placeholder="Search orders..." Width="320px" DebounceDelay="350"
                                          Fields="@SearchableFields" />
            </GridToolBar>
            <GridColumns>
                <GridColumn Field="@nameof(OrderListItem.Number)" Title="Order" Width="160px" />

                <GridColumn Field="@nameof(OrderListItem.CustomerName)" Title="Customer" Width="240px">
                    <Template Context="item">
                        @{
                            var order = (OrderListItem)item;
                        }

                        <div class="ops-customer-cell">
                            <strong>@order.CustomerName</strong>
                            <span>@order.CustomerEmail</span>
                        </div>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(OrderListItem.ProviderName)" Title="Provider" Width="180px" />

                <GridColumn Field="@nameof(OrderListItem.Total)" Title="Total" DisplayFormat="{0:C2}" Width="140px" />

                <GridColumn Field="@nameof(OrderListItem.CreatedAt)" Title="Created" DisplayFormat="{0:g}"
                            Width="180px" />

                <GridColumn Field="@nameof(OrderListItem.Status)" Title="Status" Width="150px">
                    <Template Context="item">
                        @{
                            var order = (OrderListItem)item;
                        }

                        <OrderStatusBadge Status="@order.Status" />
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
</section>

@code {
    private static readonly ProviderOption AllProvidersOption =
        new(Guid.Empty, "All providers", string.Empty);

    private readonly CancellationTokenSource _componentCancellationSource =
        new();

    private IReadOnlyList<ProviderOption> ProviderOptions { get; set; } =
    [
        AllProvidersOption
    ];

    private Guid SelectedProviderId { get; set; }
    private string? ProviderLoadError { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var providers = await ProvidersApiClient.GetProvidersAsync(
                _componentCancellationSource.Token);

            ProviderOptions =
            [
                AllProvidersOption,
                .. providers
            ];
        }
        catch (OperationCanceledException)
            when (_componentCancellationSource.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
            when (exception is HttpRequestException or
                  JsonException or
                  InvalidOperationException)
        {
            ProviderLoadError =
                "Providers could not be loaded. The provider filter is unavailable.";
        }

        await InvokeAsync(StateHasChanged);
    }

    private List<string> SearchableFields { get; } =
    [
        nameof(OrderListItem.Number),
        nameof(OrderListItem.CustomerName),
        nameof(OrderListItem.CustomerEmail),
        nameof(OrderListItem.ProviderName)
    ];

    private CancellationTokenSource? _loadCancellationSource;

    private string? LoadError { get; set; }
    private const string AllStatuses = "All statuses";

    private static readonly IReadOnlyList<string> StatusOptions =
    [
        AllStatuses,
        "Draft",
        "Pending",
        "Processing",
        "Completed",
        "Failed",
        "Cancelled"
    ];

    private TelerikGrid<OrderListItem>? _ordersGrid;

    private string SelectedStatus { get; set; } = AllStatuses;

    private async Task ReadOrdersAsync(GridReadEventArgs args)
    {
        _loadCancellationSource?.Cancel();
        _loadCancellationSource?.Dispose();

        _loadCancellationSource = new CancellationTokenSource();
        var cancellationToken = _loadCancellationSource.Token;

        LoadError = null;

        try
        {
            var request = TelerikOrderRequestMapper.Map(args.Request) with
            {
                Status = SelectedStatus == AllStatuses
                    ? null
                    : SelectedStatus,
                ProviderId = SelectedProviderId == Guid.Empty
                    ? null
                    : SelectedProviderId
            };

            var response = await OrdersApiClient.GetOrdersAsync(
                request,
                cancellationToken);

            args.Data = response.Items;
            args.Total = response.TotalCount;
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            args.Data = Array.Empty<OrderListItem>();
            args.Total = 0;
        }
        catch (Exception exception)
            when (exception is HttpRequestException or
                  JsonException or
                  InvalidOperationException)
        {
            LoadError =
                "Orders could not be loaded. Check the API and try again.";

            args.Data = Array.Empty<OrderListItem>();
            args.Total = 0;
        }
    }

    private async Task OnStatusChangedAsync(string value)
    {
        SelectedStatus = value;

        if (_ordersGrid is null)
        {
            return;
        }

        var state = _ordersGrid.GetState();
        state.Page = 1;

        await _ordersGrid.SetStateAsync(state);
    }

    private async Task OnProviderChangedAsync(Guid value)
    {
        SelectedProviderId = value;

        if (_ordersGrid is null)
        {
            return;
        }

        var state = _ordersGrid.GetState();
        state.Page = 1;

        await _ordersGrid.SetStateAsync(state);
    }

    public void Dispose()
    {
        _loadCancellationSource?.Cancel();
        _loadCancellationSource?.Dispose();

        _componentCancellationSource.Cancel();
        _componentCancellationSource.Dispose();

        GC.SuppressFinalize(this);
    }
}
